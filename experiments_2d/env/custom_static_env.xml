<mujoco>
  <option gravity="0 0 -50" integrator="RK4" timestep="0.01"/>
  <visual><map znear="0.01"/></visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.8 0.8 0.8" rgb2="1 1 1"/>
    <material name="grid_mat" texture="grid" texrepeat="10 10" reflectance="0.2"/>
  </asset>

  <default>
    <geom friction="1 0.01 0.001" solref="0.02 1" solimp="0.9 0.95 0.001"/>
    <site type="sphere" size="0.08"/>
    <default class="dot">
      <geom type="sphere" size="0.06" rgba="0.15 0.2 0.8 1"/>
    </default>
  </default>

  <worldbody>
    <camera name="top" pos="0 0 10" xyaxes="1 0 0 0 1 0"/>

    <!-- Floor + walls -->
    <geom name="floor" type="plane" size="5 5 0.1" material="grid_mat" rgba="1 1 1 1"/>
    <geom name="wall_left"  type="box" pos="-4 0 0.1" size="0.1 5 0.5" rgba="0.6 0.6 0.6 1"/>
    <geom name="wall_right" type="box" pos="4 0 0.1"  size="0.1 5 0.5" rgba="0.6 0.6 0.6 1"/>
    <geom name="wall_top"   type="box" pos="0 4 0.1"  size="5 0.1 0.5" rgba="0.6 0.6 0.6 1"/>
    <geom name="wall_bot"   type="box" pos="0 -4 0.1" size="5 0.1 0.5" rgba="0.6 0.6 0.6 1"/>

    <!-- Big obstacles -->
    <geom name="obstacle1" type="box" pos="0.5 1.5 0.1"  size="0.3 0.6 0.2" rgba="0.7 0.3 0.3 1"/>
    <geom name="obstacle2" type="box" pos="-1.0 -1.5 0.1" size="0.4 0.5 0.2" rgba="0.7 0.3 0.3 1"/>
    <geom name="obstacle3" type="box" pos="1.8 -1.0 0.1"  size="0.3 0.5 0.2" rgba="0.7 0.3 0.3 1"/>

    <!-- Start/Goal markers -->
    <site name="start" pos="-3.6 -3.6 0.02" rgba="0 1 0 1"/>
    <site name="goal"  pos=" 3.6  3.6 0.02" rgba="1 0.85 0 1"/>

    <!-- Static obstacle bodies (wrapped for APEX compatibility) -->
    <body name="cat1" pos="-3.2 3.1 0.06"><geom class="dot"/></body>
    <body name="cat2" pos="-2.6 2.8 0.06"><geom class="dot"/></body>
    <body name="cat3" pos="-3.5 2.2 0.06"><geom class="dot"/></body>
    <body name="cat4" pos="-2.9 2.0 0.06"><geom class="dot"/></body>
    <body name="cat5" pos="-2.2 3.4 0.06"><geom class="dot"/></body>
    <body name="cat6" pos="-1.6 3.2 0.06"><geom class="dot"/></body>
    <body name="cat7" pos="-0.8 2.6 0.06"><geom class="dot"/></body>
    <body name="cat8" pos="0.2 3.5 0.06"><geom class="dot"/></body>
    <body name="cat9" pos="1.0 2.9 0.06"><geom class="dot"/></body>
    <body name="cat10" pos="2.4 3.3 0.06"><geom class="dot"/></body>
    <body name="cat11" pos="3.3 2.6 0.06"><geom class="dot"/></body>
    <body name="cat12" pos="-3.3 1.0 0.06"><geom class="dot"/></body>
    <body name="cat13" pos="-2.4 1.3 0.06"><geom class="dot"/></body>
    <body name="cat14" pos="-1.7 1.0 0.06"><geom class="dot"/></body>
    <body name="cat15" pos="-0.9 1.4 0.06"><geom class="dot"/></body>
    <body name="cat16" pos="0.0 1.1 0.06"><geom class="dot"/></body>
    <body name="cat17" pos="1.2 1.2 0.06"><geom class="dot"/></body>
    <body name="cat18" pos="2.0 0.9 0.06"><geom class="dot"/></body>
    <body name="cat19" pos="3.1 1.1 0.06"><geom class="dot"/></body>
    <body name="cat20" pos="-2.0 0.2 0.06"><geom class="dot"/></body>
    <body name="cat21" pos="-1.2 -0.2 0.06"><geom class="dot"/></body>
    <body name="cat22" pos="-0.4 0.4 0.06"><geom class="dot"/></body>
    <body name="cat23" pos="0.4 -0.1 0.06"><geom class="dot"/></body>
    <body name="cat24" pos="1.1 0.3 0.06"><geom class="dot"/></body>
    <body name="cat25" pos="2.0 0.1 0.06"><geom class="dot"/></body>
    <body name="cat26" pos="3.2 -0.3 0.06"><geom class="dot"/></body>
    <body name="cat27" pos="-3.1 -1.0 0.06"><geom class="dot"/></body>
    <body name="cat28" pos="-2.3 -0.9 0.06"><geom class="dot"/></body>
    <body name="cat29" pos="-1.5 -1.2 0.06"><geom class="dot"/></body>
    <body name="cat30" pos="-0.6 -1.0 0.06"><geom class="dot"/></body>
    <body name="cat31" pos="0.3 -1.4 0.06"><geom class="dot"/></body>
    <body name="cat32" pos="1.4 -1.1 0.06"><geom class="dot"/></body>
    <body name="cat33" pos="2.4 -1.4 0.06"><geom class="dot"/></body>
    <body name="cat34" pos="3.3 -1.1 0.06"><geom class="dot"/></body>
    <body name="cat35" pos="-3.4 -2.6 0.06"><geom class="dot"/></body>
    <body name="cat36" pos="-2.6 -3.2 0.06"><geom class="dot"/></body>
    <body name="cat37" pos="-1.7 -2.8 0.06"><geom class="dot"/></body>
    <body name="cat38" pos="1.8 -3.2 0.06"><geom class="dot"/></body>
    <body name="cat39" pos="2.7 -2.6 0.06"><geom class="dot"/></body>
    <body name="cat40" pos="3.4 -3.3 0.06"><geom class="dot"/></body>

    <!-- Robot with freejoint for APEX compatibility -->
    <body name="robot" pos="-3.6 -3.6 0.12">
      <freejoint/>
      <geom name="robot_geom" type="sphere" size="0.12" rgba="0 1 0 1"/>
    </body>
  </worldbody>
</mujoco>
