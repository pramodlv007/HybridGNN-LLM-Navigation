<mujoco>
  <option gravity="0 0 -50" integrator="RK4" timestep="0.01"/>
  <visual><map znear="0.01"/></visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.8 0.8 0.8" rgb2="1 1 1"/>
    <material name="grid_mat" texture="grid" texrepeat="10 10" reflectance="0.2"/>
    <material name="nfz_mat" rgba="1 0.15 0.15 0.35"/>
    <material name="nfz2_mat" rgba="1 0.5 0.0 0.4"/>
    <material name="drone_body_mat" rgba="0.2 0.2 0.2 1"/>
    <material name="drone_arm_mat" rgba="0.4 0.4 0.4 1"/>
    <material name="drone_prop_mat" rgba="0.1 0.8 0.1 0.9"/>
  </asset>

  <default>
    <geom friction="1 0.01 0.001" solref="0.02 1" solimp="0.9 0.95 0.001"/>
    <site type="sphere" size="0.08"/>
    <default class="dynamic">
      <geom type="sphere" size="0.1" rgba="1 0.3 0.3 1"/>
    </default>
    <default class="static">
      <geom type="sphere" size="0.08" rgba="0.15 0.2 0.8 1"/>
    </default>
  </default>

  <worldbody>
    <camera name="top" pos="0 0 10" xyaxes="1 0 0 0 1 0"/>

    <!-- Floor + walls -->
    <geom name="floor" type="plane" size="5 5 0.1" material="grid_mat" rgba="1 1 1 1"/>
    <geom name="wall_left"  type="box" pos="-4 0 0.1" size="0.1 5 0.5" rgba="0.6 0.6 0.6 1"/>
    <geom name="wall_right" type="box" pos="4 0 0.1"  size="0.1 5 0.5" rgba="0.6 0.6 0.6 1"/>
    <geom name="wall_top"   type="box" pos="0 4 0.1"  size="5 0.1 0.5" rgba="0.6 0.6 0.6 1"/>
    <geom name="wall_bot"   type="box" pos="0 -4 0.1" size="5 0.1 0.5" rgba="0.6 0.6 0.6 1"/>

    <!-- NFZ 1 (CENTER) -->
    <geom name="nfz1_floor" type="box" pos="0 0 0.005" size="1.2 1.2 0.005"
          material="nfz_mat" contype="0" conaffinity="0"/>
    <geom name="nfz1_border_left"   type="box" pos="-1.2 0 0.02" size="0.02 1.22 0.04"
          rgba="1 0 0 0.9" contype="0" conaffinity="0"/>
    <geom name="nfz1_border_right"  type="box" pos="1.2 0 0.02"  size="0.02 1.22 0.04"
          rgba="1 0 0 0.9" contype="0" conaffinity="0"/>
    <geom name="nfz1_border_top"    type="box" pos="0 1.2 0.02"  size="1.22 0.02 0.04"
          rgba="1 0 0 0.9" contype="0" conaffinity="0"/>
    <geom name="nfz1_border_bottom" type="box" pos="0 -1.2 0.02" size="1.22 0.02 0.04"
          rgba="1 0 0 0.9" contype="0" conaffinity="0"/>

    <!-- NFZ 2 (RIGHT SIDE) -->
    <geom name="nfz2_floor" type="box" pos="3.0 0.0 0.005" size="0.5 0.5 0.005"
          material="nfz2_mat" contype="0" conaffinity="0"/>
    <geom name="nfz2_border_left"   type="box" pos="2.5 0.0 0.02" size="0.02 0.52 0.04"
          rgba="1 0.4 0 0.9" contype="0" conaffinity="0"/>
    <geom name="nfz2_border_right"  type="box" pos="3.5 0.0 0.02" size="0.02 0.52 0.04"
          rgba="1 0.4 0 0.9" contype="0" conaffinity="0"/>
    <geom name="nfz2_border_top"    type="box" pos="3.0 0.5 0.02" size="0.52 0.02 0.04"
          rgba="1 0.4 0 0.9" contype="0" conaffinity="0"/>
    <geom name="nfz2_border_bottom" type="box" pos="3.0 -0.5 0.02" size="0.52 0.02 0.04"
          rgba="1 0.4 0 0.9" contype="0" conaffinity="0"/>

    <!-- Start/Goal markers -->
    <site name="start" pos="-3.6 -3.6 0.02" rgba="0 1 0 1"/>
    <site name="goal"  pos=" 3.6  3.6 0.02" rgba="1 0.85 0 1"/>

    <!-- 10 DYNAMIC obstacles (cat1-cat10) - RED -->
    <body name="cat1"  pos="-3.0 -1.5 0.1"><freejoint/><geom class="dynamic"/></body>
    <body name="cat2"  pos="-2.0 -2.5 0.1"><freejoint/><geom class="dynamic"/></body>
    <body name="cat3"  pos="-1.5  2.0 0.1"><freejoint/><geom class="dynamic"/></body>
    <body name="cat4"  pos=" 2.0 -1.5 0.1"><freejoint/><geom class="dynamic"/></body>
    <body name="cat5"  pos=" 3.0 -2.0 0.1"><freejoint/><geom class="dynamic"/></body>
    <body name="cat6"  pos="-2.5  1.0 0.1"><freejoint/><geom class="dynamic"/></body>
    <body name="cat7"  pos=" 1.5  2.5 0.1"><freejoint/><geom class="dynamic"/></body>
    <body name="cat8"  pos=" 2.5  1.5 0.1"><freejoint/><geom class="dynamic"/></body>
    <body name="cat9"  pos="-1.5 -3.0 0.1"><freejoint/><geom class="dynamic"/></body>
    <body name="cat10" pos=" 3.0  2.5 0.1"><freejoint/><geom class="dynamic"/></body>

    <!-- 15 STATIC obstacles (cat11-cat25) - BLUE -->
    <body name="cat11" pos="-3.0 -2.5 0.08"><freejoint/><geom class="static"/></body>
    <body name="cat12" pos=" 3.0 -2.5 0.08"><freejoint/><geom class="static"/></body>
    <body name="cat13" pos="-3.0  2.5 0.08"><freejoint/><geom class="static"/></body>
    <body name="cat14" pos=" 3.0  2.8 0.08"><freejoint/><geom class="static"/></body>
    <body name="cat15" pos="-1.5 -1.5 0.08"><freejoint/><geom class="static"/></body>
    <body name="cat16" pos=" 1.5 -1.5 0.08"><freejoint/><geom class="static"/></body>
    <body name="cat17" pos="-1.5  1.5 0.08"><freejoint/><geom class="static"/></body>
    <body name="cat18" pos=" 1.5  1.5 0.08"><freejoint/><geom class="static"/></body>
    <body name="cat19" pos="-2.5 -0.5 0.08"><freejoint/><geom class="static"/></body>
    <body name="cat20" pos=" 2.5  0.5 0.08"><freejoint/><geom class="static"/></body>
    <body name="cat21" pos=" 0.0 -2.5 0.08"><freejoint/><geom class="static"/></body>
    <body name="cat22" pos=" 0.0  2.5 0.08"><freejoint/><geom class="static"/></body>
    <body name="cat23" pos="-2.0  3.0 0.08"><freejoint/><geom class="static"/></body>
    <body name="cat24" pos=" 2.0 -3.0 0.08"><freejoint/><geom class="static"/></body>
    <body name="cat25" pos="-2.8  0.0 0.08"><freejoint/><geom class="static"/></body>

    <!-- DRONE (replaces the green robot sphere) -->
    <!-- Drone = dark center body + 4 arms + 4 green propeller discs -->
    <body name="robot" pos="-3.6 -3.6 0.12">
      <freejoint/>
      <!-- Central body (dark box) -->
      <geom name="drone_body" type="box" size="0.06 0.06 0.02" material="drone_body_mat"/>
      <!-- Arms (4 thin cylinders at 45-degree diagonals) -->
      <geom name="drone_arm1" type="capsule" fromto="0.04 0.04 0   0.12 0.12 0" size="0.012" material="drone_arm_mat"/>
      <geom name="drone_arm2" type="capsule" fromto="-0.04 0.04 0  -0.12 0.12 0" size="0.012" material="drone_arm_mat"/>
      <geom name="drone_arm3" type="capsule" fromto="0.04 -0.04 0  0.12 -0.12 0" size="0.012" material="drone_arm_mat"/>
      <geom name="drone_arm4" type="capsule" fromto="-0.04 -0.04 0 -0.12 -0.12 0" size="0.012" material="drone_arm_mat"/>
      <!-- Propeller discs (4 green flat cylinders at arm tips) -->
      <geom name="drone_prop1" type="cylinder" pos=" 0.12  0.12 0.01" size="0.04 0.005" material="drone_prop_mat"/>
      <geom name="drone_prop2" type="cylinder" pos="-0.12  0.12 0.01" size="0.04 0.005" material="drone_prop_mat"/>
      <geom name="drone_prop3" type="cylinder" pos=" 0.12 -0.12 0.01" size="0.04 0.005" material="drone_prop_mat"/>
      <geom name="drone_prop4" type="cylinder" pos="-0.12 -0.12 0.01" size="0.04 0.005" material="drone_prop_mat"/>
    </body>
  </worldbody>
</mujoco>
